# Postgres. En Neon, DIRECT_URL es el mismo host sin el sufijo "-pooler".
DATABASE_URL="postgresql://user:password@host/db?sslmode=verify-full"
DIRECT_URL="postgresql://user:password@host-directo/db?sslmode=verify-full"

# URL publica de la aplicacion. Se usa para construir los enlaces de acceso.
APP_URL="http://localhost:3000"

# Secreto de firma de sesiones. Generar con: openssl rand -base64 48
AUTH_SECRET=""

# Cifra los numeros de cuenta de los socios. Generar con: openssl rand -base64 32
# Si se pierde, los IBAN guardados dejan de poder descifrarse.
ENCRYPTION_KEY=""

# Envio de correo. Vacio en desarrollo => los enlaces se imprimen por consola.
RESEND_API_KEY=""
EMAIL_FROM="Mi Club <no-reply@tudominio.es>"

# Correo del primer administrador, creado por `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@tudominio.es"
# Contrasena inicial del administrador. Vacia => solo podra entrar por enlace.
SEED_ADMIN_PASSWORD=""

# Socios de prueba para recorrer la aplicacion. Dejar en "false" en produccion.
SEED_DEMO_USERS="false"
SEED_DEMO_PASSWORD=""

# Protege /api/cron/cuotas. Vacio => la ruta queda desactivada.
# Generar con: openssl rand -hex 24
CRON_SECRET=""

# Solo para despliegues fuera de Vercel detras de un proxy que sobrescriba la
# cabecera indicada. Dejar vacio si no existe ese proxy de confianza.
# TRUSTED_PROXY_IP_HEADER="x-forwarded-for"

# Zona horaria del club (IANA). Se fija al dar de alta el club y no se cambia despues:
# moveria la hora de todas las reservas. Por defecto Europe/Madrid.
NEXT_PUBLIC_CLUB_TIMEZONE="Europe/Madrid"
